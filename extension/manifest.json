{
  "manifest_version": 3,
  "name": "SnipyNest Companion — HD Full-Page Web Snip",
  "version": "1.6.2",
  "minimum_chrome_version": "116",
  "description": "Copy a visible snapshot or scrolling PNG, or capture a full page as PDF. Optional desktop keys for faster capture.",
  "optional_permissions": ["nativeMessaging"],
  "optional_host_permissions": ["<all_urls>"],
  "options_ui": {"page": "options.html", "open_in_tab": true},
  "permissions": [
    "activeTab",
    "scripting",
    "tabs",
    "clipboardWrite",
    "offscreen",
    "storage"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "SnipyNest Web Snip"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "commands": {
    "capture-full-page": {
      "suggested_key": {
        "default": "Alt+Shift+S",
        "windows": "Alt+Shift+S"
      },
      "description": "Quick snapshot of the visible area, copy PNG"
    },
    "capture-long-page": {
      "suggested_key": {
        "default": "Alt+Shift+L",
        "windows": "Alt+Shift+L"
      },
      "description": "Capture full scrolling page and copy PNG"
    },
    "capture-full-page-pdf": {
      "suggested_key": {
        "default": "Alt+Shift+P",
        "windows": "Alt+Shift+P"
      },
      "description": "Capture full scrolling page as PDF and copy PNG"
    }
  },
  "key": ""
}
