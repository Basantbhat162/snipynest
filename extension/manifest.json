{
  "manifest_version": 3,
  "name": "SnipyNest Companion \u2014 HD Full-Page Web Snip",
  "version": "1.3.1",
  "minimum_chrome_version": "116",
  "description": "Capture a full webpage as a PNG on the system clipboard. SnipyNest desktop can save it to clipboard history.",
  "permissions": [
    "activeTab",
    "scripting",
    "tabs",
    "clipboardWrite",
    "offscreen",
    "storage"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "SnipyNest Web Snip"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "commands": {
    "capture-full-page": {
      "suggested_key": {
        "default": "Alt+Shift+S",
        "windows": "Alt+Shift+S"
      },
      "description": "Capture full-page webpage in HD"
    }
  }
}
